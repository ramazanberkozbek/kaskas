    "developer.history.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete study, break and app usage history, including session notes. Your settings and category rules are kept."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集中・休憩・アプリ使用の履歴を、セッションのメモを含めて削除します。設定とカテゴリルールは保持されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除专注、休息与应用使用历史，包括时段备注。设置与分类规则会保留。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalışma, mola ve uygulama kullanım geçmişini ve oturum notlarını siler. Ayarlarınız ve kategori kurallarınız korunur."
          }
        }
      }
    },
