    "settings.protection.video.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep breaks from interrupting your viewing."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "休憩で視聴が中断されないようにします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
