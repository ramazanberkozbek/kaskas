    "developer.history.confirmMessage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All history and session notes will be permanently deleted. This cannot be undone. The current focus cycle will restart."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての履歴とセッションのメモは完全に削除され、元に戻せません。現在の集中サイクルは最初からやり直しになります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有历史记录与时段备注将被永久删除，无法撤销。当前专注周期将重新开始。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm geçmiş ve oturum notları kalıcı olarak silinecek. Bu işlem geri alınamaz. Mevcut çalışma döngüsü yeniden başlatılacak."
          }
        }
      }
    },
