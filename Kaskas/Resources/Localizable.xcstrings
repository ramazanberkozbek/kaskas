    "settings.protection.video.support" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detects video playback in foreground Safari, Chrome, Edge, Brave, Arc, Opera and Chromium. Audio-only playback does not trigger a pause. Safari videos that do not emit a display-sleep signal (such as looping Shorts) and other players are currently excluded."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前面の Safari、Chrome、Edge、Brave、Arc、Opera、Chromium での動画再生を検出します。音声のみの再生では一時停止しません。ディスプレイのスリープ信号を出さない Safari の動画（ループ再生の Shorts など）や、その他のプレーヤーは現在対象外です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可检测前台 Safari、Chrome、Edge、Brave、Arc、Opera 与 Chromium 中的视频播放；仅播放音频不会触发暂停。未发出显示器休眠信号的 Safari 视频（如循环播放的 Shorts）及其他播放器暂不支持。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öndeki Safari, Chrome, Edge, Brave, Arc, Opera ve Chromium uygulamalarında video oynatımını algılar. Yalnızca ses oynatımı duraklatmayı tetiklemez. Safari’de ekran uyku sinyali üretmeyen videolar (örneğin döngüdeki Shorts) ve diğer oynatıcılar şu an kapsam dışıdır."
          }
        }
      }
    },
