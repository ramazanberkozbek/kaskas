        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认通过麦克风检测。摄像头也可能由非会议应用占用。音频与视频均不会被录制。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsayılan olarak mikrofon kullanımı algılanır. Kamera kullanımı toplantı dışındaki uygulamalardan da kaynaklanabilir. Ses ve görüntü kaydedilmez."
          }
        }
      }
    },
