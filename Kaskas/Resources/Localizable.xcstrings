    "settings.protection.meeting.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microphone detection is used by default. Camera use can also come from apps outside meetings. Audio and video are never recorded."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既定ではマイクの使用を検出します。カメラは会議以外のアプリでも使用される場合があります。音声や映像は一切録音されません。"
          }
